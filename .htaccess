<IfModule rewrite_module>
  RewriteEngine On
  RewriteBase /
</IfModule>

# ==============================================================================
# MELDIR WEB SERVER CACHE-BUSTING & FRESHNESS RULES (OpenLiteSpeed & Apache)
# ==============================================================================

# 1. Dokumen HTML, JSON, dan Service Worker DILARANG di-cache agar update selalu live
<FilesMatch "\.(html|htm|json)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>

# 2. Service Worker (sw.js) wajib selalu langsung dicek ke server tanpa perantara
<Files "sw.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</Files>

# 3. File CSS & JS Utama (Memakai versioning query param ?v=... di index.html)
<FilesMatch "\.(js|css)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# 4. Aset Statis Media Berat (Gambar & Web Fonts)
<FilesMatch "\.(jpg|jpeg|png|gif|ico|webp|svg|woff|woff2|ttf|eot)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </IfModule>
</FilesMatch>
